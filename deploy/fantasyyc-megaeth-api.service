[Unit]
Description=FantasyYC MegaETH API Server (Express.js on port 3004)
Documentation=https://github.com/unicornx/fantasyyc
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=fantasyyc
Group=fantasyyc
WorkingDirectory=/opt/fantasyyc/server
ExecStart=/usr/bin/node index.js
EnvironmentFile=/opt/fantasyyc/.env
Environment=NODE_ENV=production
Environment=PORT=3004
Environment=CHAIN_NETWORK=megaeth

# Restart policy
Restart=always
RestartSec=5
StartLimitBurst=5
StartLimitIntervalSec=60

# Graceful shutdown (gives sql.js time to save DB)
KillSignal=SIGTERM
TimeoutStopSec=30

# Security
NoNewPrivileges=true

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=fantasyyc-megaeth-api

[Install]
WantedBy=multi-user.target
